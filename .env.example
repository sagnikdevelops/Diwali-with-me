# ==============================================================================
# Diwali Greeting Website - Environment Variables Configuration Template
# ==============================================================================
# All features in this website run with ZERO MANDATORY PAID SERVICES (₹0 Budget).
# The website operates out-of-the-box with comprehensive local fallbacks.
# If you wish to enable live AI or cloud database persistence, configure the keys below.
# DO NOT commit real API keys or secrets to version control.
# ==============================================================================

# Google Gemini API Key (Optional - Free Tier)
# Get a free key at: https://aistudio.google.com/
# If left blank, the website uses a rich built-in catalog of 36+ authentic festive greetings.
GEMINI_API_KEY=

# Supabase Configuration (Optional - ₹0 Free Tier)
# Get a free project at: https://supabase.com
# Enables global real-time synchronization for "The Wall of Light" and "Sky Lanterns"
# across all devices worldwide. Run the provided 'supabase-schema.sql' in the Supabase SQL Editor.
# If left blank, the website works out-of-the-box using browser local storage & preloaded entries.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL for public social share previews (Defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

