rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Wall of Light: diyas collection
    match /diyas/{diyaId} {
      // Allow anyone to read public diyas
      allow read: if resource.data.isPublic == true;
      // Allow anyone to light a diya
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.message is string 
                    && request.resource.data.message.size() <= 300;
      // Allow delete only if needed
      allow update, delete: if false;
    }

    // 2. The Wish Wall: lanterns collection
    match /lanterns/{lanternId} {
      // Allow anyone to read public lanterns
      allow read: if resource.data.isPublic == true;
      // Allow anyone to release a lantern
      allow create: if request.resource.data.name is string 
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.wish is string 
                    && request.resource.data.wish.size() <= 200;
      // Allow delete only if needed
      allow update, delete: if false;
    }
  }
}

