rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Wall of Light: allow everyone to read and light diyas
    match /diyas/{diyaId} {
      allow read, write: if true;
    }

    // 2. Sky Lanterns / Wish Wall: allow everyone to read and release lanterns
    match /lanterns/{lanternId} {
      allow read, write: if true;
    }
  }
}
